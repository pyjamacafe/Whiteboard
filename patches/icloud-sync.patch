+import Foundation
+
+/// High-level iCloud sync state displayed in the Welcome screen sidebar.
+enum CloudSyncStatus: Equatable {
+    case localOnly
+    case syncing
+    case synced
+    case error(String)
+}
+
+/// Watches the app's iCloud Ubiquity Documents container via `NSMetadataQuery`,
+/// automatically triggers downloads of updated `.wb` / asset files, and notifies
+/// the UI when remote changes arrive.
+@MainActor
+final class CloudSyncMonitor {
+    private var query: NSMetadataQuery?
+    private var debounceTask: DispatchWorkItem?
+    private var onRemoteChange: ((Set<String>) -> Void)?
+    private var onStatusChange: ((CloudSyncStatus) -> Void)?
+    private var observers: [NSObjectProtocol] = []
+
+    func start(
+        onRemoteChange: @escaping (Set<String>) -> Void,
+        onStatusChange: @escaping (CloudSyncStatus) -> Void
+    ) {
+        stop()
+        self.onRemoteChange = onRemoteChange
+        self.onStatusChange = onStatusChange
+
+        let q = NSMetadataQuery()
+        q.searchScopes = [NSMetadataQueryUbiquitousDocumentsScope]
+        q.predicate = NSPredicate(format: "%K LIKE '*'", NSMetadataItemFSNameKey)
+
+        let center = NotificationCenter.default
+        let gatherObs = center.addObserver(
+            forName: .NSMetadataQueryDidFinishGathering,
+            object: q,
+            queue: .main
+        ) { [weak self] _ in
+            MainActor.assumeIsolated { self?.processQueryResults() }
+        }
+        let updateObs = center.addObserver(
+            forName: .NSMetadataQueryDidUpdate,
+            object: q,
+            queue: .main
+        ) { [weak self] _ in
+            MainActor.assumeIsolated { self?.processQueryResults() }
+        }
+        let accountObs = center.addObserver(
+            forName: .NSUbiquityIdentityDidChange,
+            object: nil,
+            queue: .main
+        ) { [weak self] _ in
+            MainActor.assumeIsolated {
+                if FileManager.default.ubiquityIdentityToken == nil {
+                    self?.onStatusChange?(.localOnly)
+                } else {
+                    self?.onStatusChange?(.syncing)
+                }
+            }
+        }
+
+        observers = [gatherObs, updateObs, accountObs]
+        query = q
+        q.start()
+    }
+
+    func stop() {
+        debounceTask?.cancel()
+        debounceTask = nil
+        query?.stop()
+        query = nil
+        for obs in observers {
+            NotificationCenter.default.removeObserver(obs)
+        }
+        observers.removeAll()
+    }
+
+    private func processQueryResults() {
+        guard let query else { return }
+        query.disableUpdates()
+        defer { query.enableUpdates() }
+
+        var changedBoardIds = Set<String>()
+        var hasPendingDownloads = false
+        let fm = FileManager.default
+
+        for i in 0..<query.resultCount {
+            guard let item = query.result(at: i) as? NSMetadataItem,
+                  let url = item.value(forAttribute: NSMetadataItemURLKey) as? URL else {
+                continue
+            }
+
+            let status = item.value(forAttribute: NSMetadataUbiquitousItemDownloadingStatusKey) as? String
+            let isUploading = (item.value(forAttribute: NSMetadataUbiquitousItemIsUploadingKey) as? Bool) ?? false
+
+            if status != NSMetadataUbiquitousItemDownloadingStatusCurrent {
+                hasPendingDownloads = true
+                try? fm.startDownloadingUbiquitousItem(at: url)
+            } else if isUploading {
+                hasPendingDownloads = true
+            }
+
+            if url.pathExtension == "wb" {
+                let boardId = url.deletingPathExtension().lastPathComponent
+                if !boardId.isEmpty {
+                    changedBoardIds.insert(boardId)
+                }
+            }
+        }
+
+        onStatusChange?(hasPendingDownloads ? .syncing : .synced)
+
+        debounceTask?.cancel()
+        let task = DispatchWorkItem { [weak self] in
+            self?.onRemoteChange?(changedBoardIds)
+        }
+        debounceTask = task
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4, execute: task)
+    }
+}
