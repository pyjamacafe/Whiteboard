 nonisolated struct BoardIndex: Codable, Equatable, Sendable {
     var boards: [BoardMeta]
     var folders: [BoardFolder]
+
+    /// Conflict-safe merge of two indexes (e.g. local + remote iCloud):
+    /// - Boards are unioned by `id`, keeping whichever entry has the newer `modified` timestamp.
+    /// - Folders are unioned by `id`, combining `boardIds` without duplicates.
+    static func merged(_ a: BoardIndex, _ b: BoardIndex) -> BoardIndex {
+        var boardMap: [String: BoardMeta] = [:]
+        for board in a.boards {
+            boardMap[board.id] = board
+        }
+        for board in b.boards {
+            if let existing = boardMap[board.id] {
+                if board.modified > existing.modified {
+                    boardMap[board.id] = board
+                }
+            } else {
+                boardMap[board.id] = board
+            }
+        }
+        let mergedBoards = boardMap.values.sorted { $0.modified > $1.modified }
+
+        var folderOrder: [String] = []
+        var folderMap: [String: BoardFolder] = [:]
+        for folder in a.folders + b.folders {
+            if var existing = folderMap[folder.id] {
+                var seen = Set(existing.boardIds)
+                for bid in folder.boardIds where !seen.contains(bid) {
+                    existing.boardIds.append(bid)
+                    seen.insert(bid)
+                }
+                folderMap[folder.id] = existing
+            } else {
+                folderOrder.append(folder.id)
+                folderMap[folder.id] = folder
+            }
+        }
+        let mergedFolders = folderOrder.compactMap { folderMap[$0] }
+        return BoardIndex(boards: mergedBoards, folders: mergedFolders)
+    }
 }
 
